# PostHog project token (public, safe for the browser) and ingest host.
# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time, so they
# must also be set in the deploy environment.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Flags follow volcano-web's analytics consent rule: they load only when the
# `volcano_cookie_consent` cookie (set on .volcano.dev by the marketing banner) is
# `accept` for the current Cookie Policy and Global Privacy Control is off. Locally
# the cookie is not shared, so set it by hand in devtools to test a flag.
