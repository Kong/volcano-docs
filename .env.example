# PostHog project token (public, safe for the browser) and ingest host.
# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time, so they
# must also be set in the deploy environment.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# `true` turns on anonymous visitor counting (pageviews only, nothing stored in
# the browser; see src/lib/cookieless-counting.mjs). Requires the PostHog
# project's cookieless server hash mode, or PostHog discards these events.
# Unset or anything else leaves it off.
NEXT_PUBLIC_POSTHOG_COOKIELESS_COUNTING=
