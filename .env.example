# PostHog project token (public, safe for the browser) and ingest host.
# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time, so they
# must also be set in the deploy environment.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Blog view counts. The browser records one `blog_pageview` event per post view
# with the public key above; the server reads the totals back with a PostHog
# personal API key (scope: query:read). Server-side only — never NEXT_PUBLIC_*.
# Counts need BOTH the key and the project id: with either unset, posts render
# without a view count. The project is named explicitly rather than using
# PostHog's `@current`, which resolves to whatever project the key's owner has
# selected in the PostHog UI.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# Query API host — not the ingest host above.
POSTHOG_API_HOST=https://us.posthog.com
