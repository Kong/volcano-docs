# Next.js
/.next/
/out/
next-env.d.ts

# Fumadocs MDX generated source
/.source/

# Generated at build time by scripts/emit-search-index.mjs (see build script).
# Older builds wrote search-index.json uncompressed; keep ignoring it so a stale
# local copy is never packaged into a deploy.
/public/search-index.gz
/public/search-index.json

# Never ignore anything under content/: `volcano cloud frontends deploy`
# packages the archive from .gitignore, so a tracked-but-ignored tree would be
# dropped from the deploy.

# deps
node_modules/

.DS_Store

# Local env (PostHog keys etc.)
.env*.local
