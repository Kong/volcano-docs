{
  "name": "volcano-frontend-auth-nextjs",
  "version": "1.0.0",
  "description": "Complete Next.js authentication example for Volcano",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf .next node_modules",
    "reinstall": "rm -rf node_modules yarn.lock && yarn install"
  },
  "dependencies": {
    "@volcano.dev/sdk": "^1.15.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "yarn": ">=1.22.0"
  }
}
